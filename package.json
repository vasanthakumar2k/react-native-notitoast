{
  "name": "react-native-notitoast",
  "version": "1.0.0",
  "description": "Notification-style toast messages for React Native: success, error, warning and info toasts with images, app icon, variants and full customization. Zero dependencies, Expo ready.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bob build",
    "prepare": "bob build",
    "release": "npm publish --access public"
  },
  "keywords": [
    "react-native",
  "toast",
  "react-native-toast",
  "toast-message",
  "notification",
  "in-app-notification",
  "notification-banner",
  "snackbar",
  "alert",
  "banner",
  "expo",
  "expo-go",
  "ios",
  "android",
  "typescript",
  "customizable",
  "success-toast",
  "error-toast"
  ],
  "license": "MIT",
  "author": "Vasanthakumar A <2002vasanthakumar@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasanthakumar2k/react-native-notitoast.git"
  },
  "bugs": {
    "url": "https://github.com/vasanthakumar2k/react-native-notitoast/issues"
  },
  "homepage": "https://github.com/vasanthakumar2k/react-native-notitoast#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^7.0.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
